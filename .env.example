# Database. Run `pnpm dev:db` for the bundled local Postgres, or point this at
# any Postgres instance (Neon, Supabase, RDS, ...).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres

# Public URL of the app (used by better-auth).
BETTER_AUTH_URL=http://localhost:3000

# Signs session cookies. Required in production; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=

# Comma-separated emails that are promoted to superadmin on first sign-in.
SUPERADMIN_EMAILS=

# Optional: Vercel Blob for invoice storage. Without it, files are kept in
# .data/uploads on the local filesystem.
BLOB_READ_WRITE_TOKEN=

# Optional: Vercel AI Gateway key for invoice extraction and the tax assistant.
# Without it, uploads still work and are queued for manual entry.
AI_GATEWAY_API_KEY=

# Optional: override where local invoice files are stored.
LOCAL_UPLOAD_DIR=
